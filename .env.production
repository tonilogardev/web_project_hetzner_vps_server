# nginx reverse proxy
NGINX_HTTP_PORT=80
NGINX_HTTPS_PORT=443
NGINX_SERVER_NAME=www.tonilogar.com

NGINX_CERTS_HOST=./006_nginx_reverse_proxy/certbot/certs
