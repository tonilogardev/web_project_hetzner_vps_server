# 004_test_container_dev_pro
ENVIRONMENT=development
COMMAND=dev
BASE_URL=http://localhost:
PORT_004_TEST_CONTAINER_DEV_PRO=3000

# Volúmenes para 004_test_container_dev_pro
DEV_CODE_VOLUME_HOST=./004_test_container_dev_pro
DEV_CODE_VOLUME_CONTAINER=/app
NODE_MODULES_VOLUME_HOST=004_test_container_dev_pro_node_modules
NODE_MODULES_VOLUME_CONTAINER=/app/node_modules
# 004_test_container_dev_pro

# 005_nginx_reverse_proxy
NGINX_HTTP_PORT=80
NGINX_HTTPS_PORT=443
NGINX_SERVER_NAME=localhost

NGINX_CERTS_HOST=./005_nginx_reverse_proxy/certbot/certs
NGINX_CERTS_CONTAINER=/etc/letsencrypt
NGINX_STATIC_HOST=./005_nginx_reverse_proxy/certbot/www
NGINX_STATIC_CONTAINER=/var/www/certbot

NGINX_SSL_PROTOCOLS="TLSv1.2 TLSv1.3"
NGINX_SSL_CIPHERS="ECDHE-ECDSA-AES128-GCM-SHA256:ECDHE-RSA-AES128-GCM-SHA256:ECDHE-ECDSA-AES256-GCM-SHA384:ECDHE-RSA-AES256-GCM-SHA384:ECDHE-ECDSA-CHACHA20-POLY1305:ECDHE-RSA-CHACHA20-POLY1305:DHE-RSA-AES128-GCM-SHA256:DHE-RSA-AES256-GCM-SHA384"
NGINX_SSL_SESSION_TIMEOUT=1d
NGINX_SSL_SESSION_CACHE=shared:SSL:10m

NGINX_DNS_RESOLVERS="8.8.8.8 8.8.4.4"
NGINX_DNS_RESOLVER_TIMEOUT=5s
NGINX_DNS_RESOLVER_VALID=300s
# 005_nginx_reverse_proxy
